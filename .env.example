# demo: SQLite + rule-based preview. local: SQLite + OpenAI. production: Firestore + OpenAI.
APP_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_OUTPUT_TOKENS=1000
# Production: set ONE of the following. Never commit a real credential.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Public address used only by the Vercel static build.
API_BASE_URL=http://127.0.0.1:8000
